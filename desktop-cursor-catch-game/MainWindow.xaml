<Window x:Class="DesktopCursorCatchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor Catch!"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="None">
    <Grid x:Name="RootGrid">
        <!-- Semi-transparent dark overlay -->
        <Border x:Name="DarkOverlay" Background="#01000000" />
        
        <!-- Game canvas where everything is drawn -->
        <Canvas x:Name="GameCanvas" ClipToBounds="True" />
        
        <!-- HUD Layer -->
        <Grid x:Name="HudLayer" IsHitTestVisible="False">
            <!-- Timer -->
            <TextBlock x:Name="TimerText" 
                       Text="60" 
                       FontSize="36" 
                       FontFamily="Consolas" 
                       Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top" 
                       Margin="0,20,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#22FF44" BlurRadius="15" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
            
            <!-- ESC hint -->
            <TextBlock x:Name="EscHint" 
                       Text="ESC = Beenden" 
                       FontSize="14" 
                       FontFamily="Segoe UI" 
                       Foreground="#55FFFFFF"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Bottom" 
                       Margin="0,0,20,15" />
            
            <!-- Difficulty display -->
            <TextBlock x:Name="DifficultyText" 
                       Text="Normal" 
                       FontSize="14" 
                       FontFamily="Segoe UI" 
                       Foreground="#55FFFFFF"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Bottom" 
                       Margin="20,0,0,15" />
        </Grid>
        
        <!-- Start Screen -->
        <Grid x:Name="StartScreen" Background="#DD111111">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🟢 Cursor Catch!" 
                           FontSize="52" 
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           Foreground="#33FF66" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#22FF44" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock Text="Fange den Slime-Cursor!" 
                           FontSize="18" 
                           Foreground="#AAFFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"
                           FontFamily="Segoe UI" />
                
                <TextBlock Text="Schwierigkeit:" 
                           FontSize="16" 
                           Foreground="#88FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"
                           FontFamily="Segoe UI" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Button x:Name="BtnEasy" Content="Einfach" 
                            Width="120" Height="40" Margin="5" 
                            FontSize="16" FontFamily="Segoe UI"
                            Background="#333" Foreground="#55FF55" 
                            BorderBrush="#55FF55" BorderThickness="1"
                            Cursor="Hand" />
                    <Button x:Name="BtnNormal" Content="Normal" 
                            Width="120" Height="40" Margin="5" 
                            FontSize="16" FontFamily="Segoe UI"
                            Background="#444" Foreground="#33FF66" 
                            BorderBrush="#33FF66" BorderThickness="2"
                            Cursor="Hand" />
                    <Button x:Name="BtnHard" Content="Schwer" 
                            Width="120" Height="40" Margin="5" 
                            FontSize="16" FontFamily="Segoe UI"
                            Background="#333" Foreground="#FF5555" 
                            BorderBrush="#FF5555" BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>
                
                <Button x:Name="BtnStart" Content="▶  Start" 
                        Width="200" Height="50" 
                        FontSize="22" FontFamily="Segoe UI" FontWeight="Bold"
                        Background="#22CC55" Foreground="White" 
                        BorderBrush="#33FF66" BorderThickness="2"
                        Cursor="Hand" />
                        
                <TextBlock Text="ESC = Jederzeit beenden" 
                           FontSize="13" 
                           Foreground="#55FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,25,0,0"
                           FontFamily="Segoe UI" />
            </StackPanel>
        </Grid>
        
        <!-- End Screen -->
        <Grid x:Name="EndScreen" Background="#DD111111" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EndTitle" 
                           Text="🎉 Gefangen!" 
                           FontSize="52" 
                           FontWeight="Bold"
                           Foreground="#33FF66" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"
                           FontFamily="Segoe UI">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#22FF44" BlurRadius="25" ShadowDepth="0" Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock x:Name="EndTimeText" 
                           Text="Zeit: 0.0s" 
                           FontSize="22" 
                           Foreground="#AAFFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"
                           FontFamily="Segoe UI" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnRestart" Content="🔄 Nochmal" 
                            Width="160" Height="45" Margin="10" 
                            FontSize="18" FontFamily="Segoe UI"
                            Background="#22CC55" Foreground="White" 
                            BorderBrush="#33FF66" BorderThickness="2"
                            Cursor="Hand" />
                    <Button x:Name="BtnQuit" Content="✖ Beenden" 
                            Width="160" Height="45" Margin="10" 
                            FontSize="18" FontFamily="Segoe UI"
                            Background="#CC2222" Foreground="White" 
                            BorderBrush="#FF5555" BorderThickness="2"
                            Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
