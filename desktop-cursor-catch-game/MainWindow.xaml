<Window x:Class="DesktopCursorCatchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sys"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="None">
    <Grid x:Name="RootGrid">
        <!-- Black background for Matrix look -->
        <Border x:Name="DarkOverlay" Background="#E8000000" />
        
        <!-- Game canvas where everything is drawn (Matrix rain + game) -->
        <Canvas x:Name="GameCanvas" ClipToBounds="True" />
        
        <!-- HUD Layer - Timer only, no hints -->
        <Grid x:Name="HudLayer" IsHitTestVisible="False">
            <TextBlock x:Name="TimerText" 
                       Text="" 
                       FontSize="28" 
                       FontFamily="Consolas" 
                       Foreground="#6622FF44"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top" 
                       Margin="0,15,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00FF00" BlurRadius="10" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
        
        <!-- End Screen - Hacker style -->
        <Grid x:Name="EndScreen" Background="#EE000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EndTitle" 
                           Text="CAPTURED" 
                           FontSize="64" 
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="#00FF41" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FF00" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock x:Name="EndTimeText" 
                           Text="" 
                           FontSize="20" 
                           FontFamily="Consolas"
                           Foreground="#8800FF41" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
